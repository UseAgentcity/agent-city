{
  "name": "times-square-tycoon-server",
  "private": true,
  "type": "module",
  "scripts": {
    "game": "node --env-file-if-exists=.env.game service/game-server.mjs",
    "compile": "node scripts/compile.mjs",
    "sim": "node scripts/balance-sim.mjs",
    "settle": "node --env-file-if-exists=.env.game scripts/settle.mjs",
    "auto-settle": "node --env-file-if-exists=.env.game scripts/auto-settle.mjs",
    "fork-test": "node scripts/fork-test.mjs",
    "deploy": "node --env-file-if-exists=.env.game scripts/deploy.mjs",
    "test": "node test/rate-limit.mjs && node test/tycoon.mjs && node test/city-contract.mjs && node test/auto-settle.mjs && node test/sponsor-web.mjs && node test/skill-encode.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "solc": "0.8.30"
  }
}
