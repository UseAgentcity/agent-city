# Times Square Tycoon API (port 5320). Copy to .env.game.
ARENA_PORT=5320
ARENA_PUBLIC_ORIGIN=http://localhost:5317
# Length of one game day in milliseconds (demo default: 4 minutes; the live game uses 7.5 minutes).
TYCOON_DAY_MS=240000
# Follow the live city contract (leave empty for demo mode). The API only reads the chain; it never signs.
TYCOON_CONTRACT=
TYCOON_RPC=https://bsc-dataseed.bnbchain.org
TYCOON_FROM_BLOCK=0
TYCOON_TOKEN_SYMBOL=ACITY

# ---- mainnet deployment (scripts/deploy.mjs): the city is the Flap tax vault of the token ----
# The deploying wallet deploys CityVaultFactory and launches the token through Flap's VaultPortal (it is the token's
# creator) and is the factory's upgrade admin: the only wallet that can upgrade the city. Keys are read here and never
# printed; never commit .env.game.
TYCOON_DEPLOYER=
TYCOON_OPERATOR=
TYCOON_TREASURY=
# When season 1 starts: unix seconds or ISO time (e.g. 2026-12-01T00:00:00Z; on a whole hour the 1-hour seasons
# start at :00 every hour). Day 1 plans are taken before it.
TYCOON_EPOCH=
# One game day in seconds (450). A season is 8 of them (7 trading days + settling): 1 hour, 24 a day.
# Results are published after the season ends and become claimable 10 minutes later (the challenge window).
TYCOON_DAY_SECONDS=450
# The token launched with the city: name, symbol, Flap metadata CID (image and links, uploaded to Flap first), the buy
# and sell tax in bps (all of it goes to the city), and an optional first buy by the creator in BNB.
TYCOON_TOKEN_NAME=Agent City
TYCOON_TOKEN_META=
TYCOON_TAX_BPS=200
TYCOON_FIRST_BUY_BNB=0
# A local anvil fork of BNB Chain for the rehearsal (Flap's contracts need Cancun, which Ganache cannot run):
#   anvil --fork-url https://bsc-mainnet.public.blastapi.io --chain-id 56
FORK_NODE=http://127.0.0.1:8545
DEPLOYER_KEY=
OPERATOR_KEY=
# Optional prefix for each post's result URI, e.g. the public URL where you publish the season files.
TYCOON_RESULT_BASE=
