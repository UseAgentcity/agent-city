# Times Square Tycoon API (port 5320). Copy to .env.game.
ARENA_PORT=5320
ARENA_PUBLIC_ORIGIN=http://localhost:5317
# Length of one game day in milliseconds (demo default: 4 minutes; the live game plans 3 hours).
TYCOON_DAY_MS=240000
# Follow the live city contract (leave empty for demo mode). The API only reads the chain; it never signs.
TYCOON_CONTRACT=
TYCOON_RPC=https://bsc-dataseed.bnbchain.org
TYCOON_FROM_BLOCK=0
TYCOON_TOKEN_SYMBOL=

# ---- mainnet deployment (scripts/deploy.mjs) ----
# The deploying wallet becomes the upgrade admin. Keys are read here and never printed; never commit .env.game.
TYCOON_DEPLOYER=
TYCOON_OPERATOR=
TYCOON_TREASURY=
# When season 1 starts: unix seconds or ISO time (e.g. 2026-12-01T12:00:00Z). Day 1 plans are taken before it.
TYCOON_EPOCH=
# One game day in seconds (3 hours = 10800). A season is 8 of them (7 trading days + settling).
TYCOON_DAY_SECONDS=10800
# Archive RPC used only for the read-only rehearsal on a local fork.
FORK_RPC=https://bsc-mainnet.public.blastapi.io
DEPLOYER_KEY=
OPERATOR_KEY=
